APP_URL=http://localhost:3000
PORT=3000
HOST=127.0.0.1
DATA_DIR=./data
# Docker publishing defaults to this machine only.
PUBLISH_ADDRESS=127.0.0.1
PUBLISH_PORT=3000
# Explicit opt-in for unencrypted HTTP on a trusted LAN. Prefer HTTPS.
ALLOW_INSECURE_HTTP=false
# Optional absolute appdata directory (must be writable by container UID/GID 1000).
# PA_DATA_VOLUME=/mnt/user/appdata/open-aipa
# Generate with npm run setup. Keep these values and data together in backups.
ENCRYPTION_KEY=
SETUP_TOKEN=
# Optional: configure Gmail here or in the dashboard.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional external .env path when deploying from a disposable worktree.
# PA_ENV_FILE=/absolute/path/to/persistent/.env
